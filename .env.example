# --- database (required for the leaderboard) ---
# Neon Postgres connection string. In production, set the same variable in
# Vercel (Settings → Environment Variables). Locally, paste it from the Neon
# dashboard's "Connection string" tab (use the -pooler host).
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Local dev server port (not used on Vercel)
PORT=3000

# --- sign-in (optional; the game is fully playable as guest without these) ---
# Required for ANY sign-in method. Signs the session cookies.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Required only for "Continue with Google" (create an OAuth 2.0 Web client at
# console.cloud.google.com → APIs & Services → Credentials; add
# http://localhost:3000/api/auth/google/callback and
# https://<your-app>.vercel.app/api/auth/google/callback as redirect URIs).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: force the OAuth callback base URL (auto-derived from the request if unset)
# APP_URL=https://your-app.vercel.app
